.vscode/**
.vscode-test/**
.gitignore
.gitattributes
vsc-extension-quickstart.md
tsconfig.json
src/**

# Packages themselves, so building 0.5.0 does not ship a copy of every earlier build inside it.
*.vsix

# Build input, not a runtime asset. resources/logo_echo.png is generated from it — see CHANGELOG 0.3.0.
resources/logo_echo.svg

# The grammar regression suite and TypeScript sources. The runtime is dist/extension.js plus the
# grammars; nothing in src/ or tests/ is reachable once it is installed.
tests/**
node_modules/**
package-lock.json
